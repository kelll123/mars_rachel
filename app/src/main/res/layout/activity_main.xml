<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- Header Banner -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang 👋"
            android:textColor="#718096"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="BELAJAR MOBILE"
            android:textColor="#1A202C"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Container Tombol Menu Utama -->
    <LinearLayout
        android:id="@+id/menuContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/btnLogout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerContainer">

        <!-- Tombol Pertemuan 4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToFourth"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:text="Pertemuan 4"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#3182CE"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_agenda"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Tombol Pertemuan 5 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTofifthifth"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Pertemuan 5"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#2B6CB0"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_compass"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

    </LinearLayout>

    <!-- Tombol Logout -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Logout"
        android:textAllCaps="false"
        android:textColor="#E53E3E"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#FFF5F5"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_lock_power_off"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="#E53E3E"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#FEB2B2"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>